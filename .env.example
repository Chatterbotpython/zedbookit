# Copy to .env and fill in from Firebase console > Project settings > Your apps (web app).
# These EXPO_PUBLIC_* values are bundled into the app (Firebase web config is not secret; access is
# controlled by firestore.rules / storage.rules). NEVER put service-account keys or R2 secrets here.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

EXPO_PUBLIC_R2_UPLOAD_ENDPOINT=
EXPO_PUBLIC_R2_PUBLIC_URL=

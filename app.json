{
  "expo": {
    "name": "ZedBookIt",
    "slug": "zedbookit",
    "scheme": "zedbookit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B0E12"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zedbookit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E12"
      },
      "package": "com.zedbookit.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZedBookIt uses your photos to let you upload property and maintenance images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E7A5C"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
